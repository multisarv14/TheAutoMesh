# ─────────────────────────────────────────────
# App URL
# ─────────────────────────────────────────────
# The public URL where this app is hosted.
# Used for OAuth callbacks and self-referential links.
# Cloud Run example: https://your-service.asia-southeast1.run.app
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Local MongoDB (recommended for development):
MONGODB_URI="mongodb://127.0.0.1:27017/automech"

# If MongoDB is not running locally, the app will auto-start an in-memory MongoDB server.
# Production: use a real MongoDB Atlas or managed MongoDB URL.

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────
# Change this to a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# ─────────────────────────────────────────────
# Meta / Facebook Graph API
# ─────────────────────────────────────────────
# Create an app at: https://developers.facebook.com/
FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
FACEBOOK_APP_SECRET="YOUR_FACEBOOK_APP_SECRET"
FACEBOOK_VERIFY_TOKEN="your_custom_verify_token"
